# 目标源码: LiBwrt/LibWrt 分支 25.12-nss
# 机型: qualcommax / ipq60xx / cmiot_ax18 (中移物联 AX18, IPQ6000)
# 说明: 本配置为「纯净有线主/旁路由」固件, 已剔除无线组件

# 核心机型锁定
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_cmiot_ax18=y

# 中文 LuCI 后台与 DNSMasq 管理
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-app-dnsmasq=y

# 网络加速与常用工具
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-ddns=y

# LED 灯光高级控制
CONFIG_PACKAGE_luci-app-ledtrig-system=y
CONFIG_PACKAGE_kmod-leds-gpio=y

# 高级运维与主题
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-fileassistant=y
CONFIG_PACKAGE_luci-i18n-fileassistant-zh-cn=y

# 彻底移除无线组件（有线主/旁路由）
CONFIG_PACKAGE_kmod-ath11k=n
CONFIG_PACKAGE_kmod-ath11k-ahb=n
CONFIG_PACKAGE_wpad-openssl=n

# 无 USB 硬件, 关闭上层挂载与存储组件
CONFIG_PACKAGE_kmod-usb-storage=n
CONFIG_PACKAGE_kmod-usb-core=n

# ==================== 代理依赖全家桶（轻量化纯净版） ====================
# 核心底层控制与传输
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_libcap=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_coreutils-nohup=y

# 密码学与解密加速
CONFIG_PACKAGE_libopenssl-conf=y
CONFIG_PACKAGE_libopenssl-legacy=y
CONFIG_PACKAGE_ipsec-tools=y

# nftables 防火墙流量转发规则
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-bridge=y
CONFIG_PACKAGE_kmod-nft-nat=y

# HomeProxy 代理平台（sing-box 内核；firewall4/kmod-tun/nft-tproxy 已在上方选中）
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_ucode-mod-digest=y

# 高性能 DNS 分流
CONFIG_PACKAGE_dnsmasq-full=y

# 高通 NSS 硬件转发加速（网桥 / 拨号 / VLAN）
CONFIG_PACKAGE_kmod-qca-nss-ecm=y
CONFIG_PACKAGE_kmod-qca-nss-drv-bridge-mgr=y
CONFIG_PACKAGE_kmod-qca-nss-drv-vlan=y
